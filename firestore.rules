rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    function twoDigits(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    /** UTC YYYY-MM-DD. Used only to allow deleting previous days' scores. */
    function utcDateId() {
      return string(request.time.year())
        + '-' + twoDigits(request.time.month())
        + '-' + twoDigits(request.time.day());
    }

    // Doc ID = Auth UID. Fields: name, role (admin|guest), active.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Daily leaderboards (all games). Read public; submit requires login; old days can be deleted.
    match /gameScores/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.game is string
        && request.resource.data.dateId is string
        && request.resource.data.dateId.size() == 10
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 32
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && (
          request.resource.data.game != 'wordle'
          || (request.resource.data.score >= 1 && request.resource.data.score <= 6)
        );
      allow update: if false;
      allow delete: if (resource.data.dateId is string && resource.data.dateId < utcDateId())
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Legacy Wordle scores — read + delete only so the daily cleanse can empty them.
    match /wordleScores/{scoreId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if true;
    }

    match /gratitude/{id} {
      allow read: if true;
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 500;
      allow update, delete: if isAdmin();
    }

    match /timeline/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /wordleWords/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wordleDaily/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizQuestions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /crosswordPuzzles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /spellingBeePuzzles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sevaHours/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
