rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    /**
     * The community wall's whole reaction vocabulary. This list is the feature
     * — `data/communityReactions.ts` only decides how these five are drawn.
     */
    function reactionKeys() {
      return ['like', 'love', 'smile', 'honey', 'strength'];
    }

    // A wall post's tally for one reaction. The map is absent until the post's
    // first reaction, so every read of it has to survive not being there.
    // Shared, because the post's rule and the vote's rule below have to agree
    // on what a count is.
    function reactionTally(data, key) {
      return ('reactions' in data) ? data.reactions.get(key, 0) : 0;
    }

    // Doc ID = Auth UID. Fields: name, active.
    //
    // isAdmin() above is the whole model: the document exists and is active.
    // There is no privilege tier — an admins document grants every write path
    // in this file, including creating further admins. Documents used to carry
    // a `role` of 'admin' or 'guest' and nothing ever read it, so the field has
    // been dropped from the app rather than left implying a limit. A read-only
    // tier has to start here, in the rules, before any UI can offer it.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Minimal policy-acceptance record. Doc ID = Auth UID; readable only by its owner.
    match /users/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'userId',
          'privacyPolicyVersion',
          'sitePolicyVersion',
          'privacyAcceptedAt',
          'sitePolicyAcceptedAt',
          'updatedAt',
          'displayName'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.privacyPolicyVersion is string
        && request.resource.data.sitePolicyVersion is string
        && request.resource.data.privacyAcceptedAt == request.time
        && request.resource.data.sitePolicyAcceptedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          !('displayName' in request.resource.data)
          || (
            request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 32
          )
        );
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'updatedAt'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 32
            && request.resource.data.updatedAt == request.time
          )
          || (
            request.resource.data.keys().hasOnly([
              'userId',
              'privacyPolicyVersion',
              'sitePolicyVersion',
              'privacyAcceptedAt',
              'sitePolicyAcceptedAt',
              'updatedAt',
              'displayName'
            ])
            && request.resource.data.privacyPolicyVersion is string
            && request.resource.data.sitePolicyVersion is string
            && request.resource.data.privacyAcceptedAt == request.time
            && request.resource.data.sitePolicyAcceptedAt == request.time
            && request.resource.data.updatedAt == request.time
          )
        );
    }

    // One document per signed-in user/device. FCM tokens are private account data.
    match /pushSubscriptions/{subscriptionId} {
      // Doc IDs are `{uid}_{tokenHash}`, so ownership can be checked before the doc exists.
      function ownsSubscriptionId() {
        return isSignedIn()
          && subscriptionId.matches('^' + request.auth.uid + '_.*');
      }

      // get must work for missing docs (first subscribe). list stays owner-scoped for export/delete.
      allow get: if ownsSubscriptionId();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if ownsSubscriptionId()
        && request.resource.data.keys().hasOnly([
          'userId', 'token', 'topics', 'enabled', 'platform', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 4096
        && request.resource.data.topics is list
        && request.resource.data.topics.size() <= 4
        && request.resource.data.topics.hasOnly(['announcements', 'games', 'niyams', 'niyam-milestones'])
        && request.resource.data.enabled == true
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 240
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsSubscriptionId()
        && resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'token', 'topics', 'enabled', 'platform', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 4096
        && request.resource.data.topics is list
        && request.resource.data.topics.size() <= 4
        && request.resource.data.topics.hasOnly(['announcements', 'games', 'niyams', 'niyam-milestones'])
        && request.resource.data.enabled == true
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // Delivery audit shown in the admin portal. Only Cloud Functions writes these.
    match /pushMessages/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // In-app copy of every announcement, so a missed OS notification is not lost.
    // Written only by Cloud Functions; read state is kept on the device.
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Admin test sends. Private to the admin who triggered them, so a test is
    // never visible in the shared inbox. Only Cloud Functions writes these.
    match /testNotifications/{uid}/messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Nightly activity snapshots for the admin Insights trend. Aggregate counts
    // only, never per-person. Written by a scheduled Cloud Function.
    match /dailyStats/{dateId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Per-device-independent inbox state: what has been read and what has been
    // dismissed. Notifications themselves are shared and read-only, so this is
    // where anything user-specific has to live. Doc ID = Auth UID.
    match /notificationState/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userId', 'lastReadAt', 'dismissedIds', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.lastReadAt is number
        && request.resource.data.dismissedIds is list
        && request.resource.data.dismissedIds.size() <= 200
        && request.resource.data.updatedAt == request.time;
    }

    // Daily leaderboards (all games). Read public; submit requires login.
    //
    // The document id is pinned to `{game}_{dateId}_{uid}` (or `{game}_{uid}`
    // for an all-time board). Without that constraint a signed-in user could
    // write unlimited documents under any id, with any `userName` and any
    // `dateId` — which on a mandir leaderboard makes impersonating a sant or a
    // trustee a one-line console command, and makes flooding free.
    //
    // Still open by design: `userName` is client-supplied, so a player can set
    // the name shown against their own row. Rules cannot fix that — the only
    // trustworthy name lives in the auth token, and email/password accounts
    // have no `name` claim to read. Closing it means submitting scores through
    // a callable that stamps the name server-side, the way
    // `handleGameAchievements` already does for broadcast text.
    match /gameScores/{scoreId} {
      function ownsScoreId() {
        return scoreId == request.resource.data.game + '_' + request.resource.data.dateId + '_' + request.auth.uid
          || scoreId == request.resource.data.game + '_' + request.auth.uid;
      }

      allow read: if true;
      allow create: if isSignedIn()
        && ownsScoreId()
        && request.resource.data.keys().hasOnly([
          'game', 'dateId', 'userId', 'userName', 'score', 'timeMs', 'detail', 'completedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.game is string
        && request.resource.data.dateId is string
        && request.resource.data.dateId.matches('^20[2-9][0-9]-[0-1][0-9]-[0-3][0-9]$')
        && request.resource.data.completedAt == request.time
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 32
        && request.resource.data.score is number
        && request.resource.data.score == int(request.resource.data.score)
        && request.resource.data.score >= 0
        && request.resource.data.score <= 9999999
        && (
          request.resource.data.game != 'wordle'
          || (request.resource.data.score >= 1 && request.resource.data.score <= 6)
        )
        && (
          !('timeMs' in request.resource.data)
          || (
            request.resource.data.timeMs is number
            && request.resource.data.timeMs == int(request.resource.data.timeMs)
            && request.resource.data.timeMs >= 0
            && request.resource.data.timeMs <= 86400000
          )
        );
      // Own score updates. Identity and the day it belongs to are immutable;
      // only the result may improve.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.game == resource.data.game
        && request.resource.data.dateId == resource.data.dateId
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 32
        && request.resource.data.keys().hasOnly([
          'game', 'dateId', 'userId', 'userName', 'score', 'timeMs', 'detail', 'completedAt'
        ])
        && request.resource.data.score is number
        && request.resource.data.score == int(request.resource.data.score)
        && request.resource.data.score >= 0
        && request.resource.data.score <= 9999999
        && (
          !('timeMs' in request.resource.data)
          || (
            request.resource.data.timeMs is number
            && request.resource.data.timeMs == int(request.resource.data.timeMs)
            && request.resource.data.timeMs >= 0
            && request.resource.data.timeMs <= 86400000
          )
        );
      // Previously: anyone, signed in or not, could delete any row from a past
      // day — because `cleanseOldScores` ran the sweep in every visitor's
      // browser and the rule had to permit it. The sweep is now
      // `pruneOldGameScores` in functions/index.js, which runs with admin
      // credentials, so the open clause is gone.
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Legacy Wordle scores. Drained by the scheduled prune, not by visitors —
    // `allow delete: if true` let any anonymous caller empty the collection.
    match /wordleScores/{scoreId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // The community wall.
    //
    // Posting now requires an account. Previously anyone could write here with
    // no auth and no field allowlist, which allowed three things at once: a
    // message signed with any `name` at all — a sant's, a trustee's, anyone's
    // — unlimited automated flooding, and a client-chosen `createdAt` far in
    // the future, which pinned a post to the top of the wall permanently.
    //
    // Requiring sign-in keeps the *display* anonymity people actually want:
    // `anonymous` still hides the name on the wall. It removes only the
    // ability to post as someone else. `userId` is stored so a member can
    // delete their own note and admins can moderate.
    match /gratitude/{id} {
      allow read: if true;
      // `userId` is optional and must be ABSENT on an anonymous post. This
      // collection is world readable and `playStreaks` is a public
      // uid-to-name map, so a uid stored here would make `anonymous` a mask
      // over a document that names its author. The author link lives in
      // `gratitudeAuthors` instead, readable only by admins.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'name', 'message', 'prompt', 'anonymous', 'createdAt'
        ])
        && request.resource.data.anonymous is bool
        && (
          request.resource.data.anonymous == true
            ? !('userId' in request.resource.data)
            : request.resource.data.userId == request.auth.uid
        )
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 500
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.prompt == null
          || (request.resource.data.prompt is string && request.resource.data.prompt.size() <= 120)
        );
      // An anonymous post has no `userId` to match, so its author cannot remove
      // it from the app — that is the cost of the wall not naming them. Admins
      // can, and the link in `gratitudeAuthors` tells them whose it is.
      allow delete: if isAdmin()
        || (isSignedIn() && ('userId' in resource.data) && resource.data.userId == request.auth.uid);

      /**
       * The reaction tallies. `reactions` is a map of the five keys below to
       * counts, and it is the only field a devotee may touch on someone
       * else's post.
       *
       * The count is public and the voter is not, so the two halves live in
       * different documents — and the rule that lets a browser move a count is
       * the rule that binds it to that browser's own vote. `getAfter` reads
       * `gratitudeReactionVotes/{postId}_{uid}` as it will be once this batch
       * commits, so a count can only move by the single step that vote just
       * took: one person, one reaction, one increment. Writing the count on its
       * own, or moving it by two, or moving someone else's, all fail here.
       *
       * This is the same promise `niyamChallengeStats` makes by keeping its
       * totals off the browser entirely. A wall reaction does not warrant a
       * Cloud Function in the middle of it, and a tally that only appeared
       * after the next functions deploy would read as a broken button.
       */
      // A count moves by +1 for the reaction just chosen and -1 for the one
      // given up. Switching moves two keys; every other key must stand still.
      function reactionMoved(key, prev, next) {
        return reactionTally(request.resource.data, key) == reactionTally(resource.data, key)
          + (next == key ? 1 : 0)
          - (prev == key ? 1 : 0);
      }
      function isReactionUpdate() {
        let voteRef = /databases/$(database)/documents/gratitudeReactionVotes/$(id + '_' + request.auth.uid);
        let prev = exists(voteRef) ? get(voteRef).data.key : '';
        let next = existsAfter(voteRef) ? getAfter(voteRef).data.key : '';
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          // No vote changed hands, so there is nothing for a count to follow.
          && prev != next
          && request.resource.data.reactions.keys().hasOnly(reactionKeys())
          && reactionMoved('like', prev, next)
          && reactionMoved('love', prev, next)
          && reactionMoved('smile', prev, next)
          && reactionMoved('honey', prev, next)
          && reactionMoved('strength', prev, next);
      }
      // The devotee's path is checked first: it is the common one, and it
      // saves the two reads isAdmin() costs on every reaction.
      allow update: if (isSignedIn() && isReactionUpdate()) || isAdmin();
    }

    /**
     * Who reacted with what. Never public, for the reason `gratitudeAuthors`
     * is never public: `playStreaks` is a world-readable uid-to-name map, so a
     * uid stored beside a post is a name stored beside a post, and the wall is
     * a place people post anonymously.
     *
     * Doc IDs are `{postId}_{uid}` so the post's rule above can find this
     * document by path, and so ownership is decidable before it exists. One
     * document per person per post is what makes a reaction a single vote
     * rather than a counter anyone can hold down.
     */
    match /gratitudeReactionVotes/{voteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['postId', 'userId', 'key', 'createdAt'])
        && request.resource.data.keys().hasAll(['postId', 'userId', 'key', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && voteId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.key in reactionKeys()
        && request.resource.data.createdAt == request.time;

      /**
       * Taking a reaction back has to take the count with it. Without this a
       * devotee could delete the vote on its own and then react again, adding
       * to the same tally twice, and again, for as long as they liked — the
       * post's rule above only ever sees a fresh vote.
       *
       * Unless the post is gone, deleted by its author or an admin or by this
       * very batch: then there is no tally left to correct and the vote is
       * only an orphan to clear, which is what lets "delete my account" sever
       * reactions on posts that no longer exist.
       */
      function releasesItsCount() {
        let postRef = /databases/$(database)/documents/gratitude/$(resource.data.postId);
        return !exists(postRef)
          || !existsAfter(postRef)
          || reactionTally(getAfter(postRef).data, resource.data.key)
             == reactionTally(get(postRef).data, resource.data.key) - 1;
      }
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid && releasesItsCount());
    }

    /**
     * Who wrote which wall post. Never public — this is the half of an
     * anonymous post that must not be readable, kept apart so moderation can
     * still find an author without the wall itself naming one.
     *
     * The owner may read and delete their own link, which is what lets "delete
     * my account" sever it. Once severed the post stays and is genuinely
     * anonymous, because nothing anywhere ties it back to a person.
     */
    match /gratitudeAuthors/{postId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['postId', 'userId', 'createdAt'])
        && request.resource.data.postId == postId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Anyone may report a bug. Reports are private and managed by admins.
    match /bugReports/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'title', 'description', 'pageUrl', 'contactEmail', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['title', 'description', 'status', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && (
          !('pageUrl' in request.resource.data)
          || request.resource.data.pageUrl == null
          || (
            request.resource.data.pageUrl is string
            && request.resource.data.pageUrl.size() <= 300
            // Defence in depth with the admin page, which also refuses to link
            // anything that is not http(s). Reports are unauthenticated, so a
            // `javascript:` URL here would be a one-click takeover of whichever
            // trustee opens the queue.
            && request.resource.data.pageUrl.matches('^https?://.*')
          )
        )
        && (
          !('contactEmail' in request.resource.data)
          || request.resource.data.contactEmail == null
          || (request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() <= 150)
        );
      allow read, update, delete: if isAdmin();
    }

    match /timeline/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /yajmanOpportunities/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /wordleWords/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameWords/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wordleDaily/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }


    match /onePercentQuestions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /miniCrosswordPuzzles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /connectionsPuzzles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bracketCityPuzzles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A signed-in user's daily Play visit streak. Public read powers the leaderboard.
    match /playStreaks/{uid} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 32
        && request.resource.data.currentStreak is int
        && request.resource.data.currentStreak >= 1
        && request.resource.data.longestStreak is int
        && request.resource.data.longestStreak >= request.resource.data.currentStreak
        && request.resource.data.lastVisitDate is string
        && request.resource.data.lastVisitDate.size() == 10;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Public profile card — display name only. Private policy fields stay on `users`.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userId', 'displayName', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Unlocked achievements are public so devotee profiles can show them.
    // Only Cloud Functions write unlocks; the owner may delete on account removal.
    match /userAchievements/{uid} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Current all-time crown holders are public; only Cloud Functions writes them.
    match /achievementCrowns/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Which games a user finished on a given day, so results follow them across devices.
    match /playCompletions/{uid}/days/{dateId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.dateId is string
        && request.resource.data.dateId.size() == 10
        && request.resource.data.games is map
        && request.resource.data.games.size() <= 12;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // The personal daily niyam tracker is retired — the niyams area is the
    // shared challenges now. `niyams` (the checklist) and `niyamStats` (its
    // community counter) have no rules at all any more, so they are closed by
    // default; whatever documents are left in them are dead data an admin can
    // clear from the console.
    //
    // `niyamProgress` is the exception because it is *personal* data: the ticks
    // a devotee saved while the tracker existed. Nothing writes it any more, so
    // it is read-and-delete only, and only for its owner. That is what keeps
    // "delete my account" able to erase it. Once the collection has been
    // emptied, this block and the legacy branch in `useAccountPrivacy` can go.
    match /niyamProgress/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if false;
    }

    // Admin-set community goals — "10,000 malas between now and Patotsav".
    // Public read so the progress bar works for a signed-out visitor too.
    match /niyamChallenges/{challengeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Per-person rollups, derived by `syncNiyamChallengeTotals`. Top rows are
      // shown on the public niyam leaderboard; a devotee still reads only their
      // own doc when signed in.
      match /contributors/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Community totals per challenge. Written only by Cloud Functions, so the
    // number on the progress bar is not one anybody can type in — the retired
    // tracker's counter was client-written, and this one never was.
    match /niyamChallengeStats/{challengeId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // What each devotee has added to a challenge.
    //
    // Entries are private — yours and the admins', never the whole sangat's.
    // An individual mala count is personal sadhana, not a leaderboard row.
    //
    // The anti-inflation rule lives here rather than in the app. `status` is
    // not free text: it must be exactly what the challenge's `autoApproveMax`
    // implies, so an implausibly large entry is written as `pending` even by a
    // caller talking to Firestore directly with no UI in the way. Only an admin
    // can move it to `approved`, and only an `approved` entry is folded into
    // the community total by `syncNiyamChallengeTotals`.
    match /niyamSubmissions/{submissionId} {
      function challenge() {
        return get(/databases/$(database)/documents/niyamChallenges/$(request.resource.data.challengeId)).data;
      }
      function challengeExists() {
        return exists(/databases/$(database)/documents/niyamChallenges/$(request.resource.data.challengeId));
      }
      // Missing limits on older published docs fall back to the same defaults
      // admins get when they publish from the seed list.
      function autoApproveMax(c) {
        return (('autoApproveMax' in c) && (c.autoApproveMax is number)) ? c.autoApproveMax : 108;
      }
      function maxPerSubmission(c) {
        return (('maxPerSubmission' in c) && (c.maxPerSubmission is number)) ? c.maxPerSubmission : 5000;
      }
      function isOpen(c) {
        return c.active == true
          && (!('startAt' in c) || c.startAt == null || request.time >= c.startAt)
          && (!('endAt' in c) || c.endAt == null || request.time <= c.endAt);
      }

      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && challengeExists()
        && submissionId.matches('^' + request.resource.data.challengeId + '__.*')
        && request.resource.data.keys().hasOnly([
             'challengeId', 'userId', 'userName', 'amount', 'note',
             'status', 'statusKey', 'userChallengeKey', 'dayKey', 'createdAt',
             'checkinSlot'
           ])
        && request.resource.data.keys().hasAll([
             'challengeId', 'userId', 'userName', 'amount',
             'status', 'statusKey', 'userChallengeKey', 'dayKey', 'createdAt'
           ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userChallengeKey ==
             request.auth.uid + '__' + request.resource.data.challengeId
        && request.resource.data.statusKey ==
             request.resource.data.challengeId + '__' + request.resource.data.status
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 32
        && request.resource.data.dayKey is string
        && request.resource.data.dayKey.matches('^20[2-9][0-9]-[0-1][0-9]-[0-3][0-9]$')
        && (
             request.resource.data.note == null
             || (request.resource.data.note is string && request.resource.data.note.size() <= 240)
           )
        && request.resource.data.amount is number
        && request.resource.data.amount == int(request.resource.data.amount)
        && request.resource.data.amount >= 1
        && request.resource.data.amount <= maxPerSubmission(challenge())
        && request.resource.data.createdAt == request.time
        && isOpen(challenge())
        && request.resource.data.status == (
             (('inputMode' in challenge()) && challenge().inputMode == 'checkin')
               ? 'approved'
               : (request.resource.data.amount <= autoApproveMax(challenge()) ? 'approved' : 'pending')
           )
        && (
             !('checkinSlot' in request.resource.data)
             || (
               (('inputMode' in challenge()) && challenge().inputMode == 'checkin')
               && request.resource.data.checkinSlot in ['morning', 'evening']
               && request.resource.data.amount == 1
             )
           );

      // Only an admin decides what counts. Identity, amount, day and the
      // challenge it belongs to are immutable — a review changes the verdict,
      // never the claim.
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
             'challengeId', 'userId', 'userName', 'amount', 'note',
             'status', 'statusKey', 'userChallengeKey', 'dayKey', 'createdAt',
             'checkinSlot', 'reviewedAt', 'reviewedBy', 'reviewNote'
           ])
        && request.resource.data.challengeId == resource.data.challengeId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userChallengeKey == resource.data.userChallengeKey
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.dayKey == resource.data.dayKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['approved', 'pending', 'rejected']
        && request.resource.data.statusKey ==
             resource.data.challengeId + '__' + request.resource.data.status
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && (
             request.resource.data.reviewNote == null
             || (request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 240)
           );

      // A devotee can withdraw their own entry — a mistyped count, usually.
      // The trigger unwinds it from the totals either way.
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Privacy / policy pages. Public read; admin write.
    match /sitePages/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin-managed homepage tiles, navigation, community prompts, and seva teams. Public read.
    match /siteContent/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Bilingual reading texts linked from niyams (stotra, path, etc.). Public read.
    match /niyamDocuments/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Personal mandir visits for the "Visit Mandir" niyam. Private to the user.
    // Document ID is the UK date (YYYY-MM-DD), so one visit per day is enforced
    // by design — writing the same date twice is an update, not a duplicate.
    match /mandirVisits/{uid}/visits/{dateKey} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userId', 'dateKey', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['userId', 'dateKey', 'source', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.dateKey == dateKey
        && request.resource.data.dateKey.matches('^20[2-9][0-9]-[0-1][0-9]-[0-3][0-9]$')
        && request.resource.data.source in ['auto', 'manual']
        && request.resource.data.createdAt == request.time;
      // Updates not allowed — a visit is immutable once recorded.
      allow update: if false;
    }
  }
}
