rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    function twoDigits(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    /** UTC YYYY-MM-DD. Used only to allow deleting previous days' scores. */
    function utcDateId() {
      return string(request.time.year())
        + '-' + twoDigits(request.time.month())
        + '-' + twoDigits(request.time.day());
    }

    // Doc ID = Auth UID. Fields: name, role (admin|guest), active.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Minimal policy-acceptance record. Doc ID = Auth UID; readable only by its owner.
    match /users/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'userId',
          'privacyPolicyVersion',
          'sitePolicyVersion',
          'privacyAcceptedAt',
          'sitePolicyAcceptedAt',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.privacyPolicyVersion is string
        && request.resource.data.sitePolicyVersion is string
        && request.resource.data.privacyAcceptedAt == request.time
        && request.resource.data.sitePolicyAcceptedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    // One document per signed-in user/device. FCM tokens are private account data.
    match /pushSubscriptions/{subscriptionId} {
      // Doc IDs are `{uid}_{tokenHash}`, so ownership can be checked before the doc exists.
      function ownsSubscriptionId() {
        return isSignedIn()
          && subscriptionId.matches('^' + request.auth.uid + '_.*');
      }

      // get must work for missing docs (first subscribe). list stays owner-scoped for export/delete.
      allow get: if ownsSubscriptionId();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if ownsSubscriptionId()
        && request.resource.data.keys().hasOnly([
          'userId', 'token', 'topics', 'enabled', 'platform', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 4096
        && request.resource.data.topics is list
        && request.resource.data.topics.size() <= 2
        && request.resource.data.topics.hasOnly(['announcements', 'games'])
        && request.resource.data.enabled == true
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 240
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsSubscriptionId()
        && resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'token', 'topics', 'enabled', 'platform', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 4096
        && request.resource.data.topics is list
        && request.resource.data.topics.size() <= 2
        && request.resource.data.topics.hasOnly(['announcements', 'games'])
        && request.resource.data.enabled == true
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // Delivery audit shown in the admin portal. Only Cloud Functions writes these.
    match /pushMessages/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // In-app copy of every announcement, so a missed OS notification is not lost.
    // Written only by Cloud Functions; read state is kept on the device.
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Daily leaderboards (all games). Read public; submit requires login; old days can be deleted.
    match /gameScores/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.game is string
        && request.resource.data.dateId is string
        && request.resource.data.dateId.size() == 10
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 32
        && request.resource.data.score is number
        && request.resource.data.score == int(request.resource.data.score)
        && request.resource.data.score >= 0
        && request.resource.data.score <= 9999999
        && (
          request.resource.data.game != 'wordle'
          || (request.resource.data.score >= 1 && request.resource.data.score <= 6)
        )
        && (
          !('timeMs' in request.resource.data)
          || (
            request.resource.data.timeMs is number
            && request.resource.data.timeMs == int(request.resource.data.timeMs)
            && request.resource.data.timeMs >= 0
            && request.resource.data.timeMs <= 86400000
          )
        );
      // Own score updates.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.game == resource.data.game
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 32
        && request.resource.data.score is number
        && request.resource.data.score == int(request.resource.data.score)
        && request.resource.data.score >= 0
        && request.resource.data.score <= 9999999
        && (
          !('timeMs' in request.resource.data)
          || (
            request.resource.data.timeMs is number
            && request.resource.data.timeMs == int(request.resource.data.timeMs)
            && request.resource.data.timeMs >= 0
            && request.resource.data.timeMs <= 86400000
          )
        );
      allow delete: if (resource.data.dateId is string && resource.data.dateId < utcDateId())
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Legacy Wordle scores — read + delete only so the daily cleanse can empty them.
    match /wordleScores/{scoreId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if true;
    }

    match /gratitude/{id} {
      allow read: if true;
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // Anyone may report a bug. Reports are private and managed by admins.
    match /bugReports/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'title', 'description', 'pageUrl', 'contactEmail', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['title', 'description', 'status', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && (
          !('pageUrl' in request.resource.data)
          || request.resource.data.pageUrl == null
          || (request.resource.data.pageUrl is string && request.resource.data.pageUrl.size() <= 300)
        )
        && (
          !('contactEmail' in request.resource.data)
          || request.resource.data.contactEmail == null
          || (request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() <= 150)
        );
      allow read, update, delete: if isAdmin();
    }

    match /timeline/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /yajmanOpportunities/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /wordleWords/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameWords/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wordleDaily/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }


    match /onePercentQuestions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /miniCrosswordPuzzles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /connectionsPuzzles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A signed-in user's daily Play visit streak. Public read powers the leaderboard.
    match /playStreaks/{uid} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 32
        && request.resource.data.currentStreak is int
        && request.resource.data.currentStreak >= 1
        && request.resource.data.longestStreak is int
        && request.resource.data.longestStreak >= request.resource.data.currentStreak
        && request.resource.data.lastVisitDate is string
        && request.resource.data.lastVisitDate.size() == 10;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Personal achievement unlocks are private to the signed-in user; only Cloud Functions writes them.
    match /userAchievements/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Current all-time crown holders are public; only Cloud Functions writes them.
    match /achievementCrowns/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Which games a user finished on a given day, so results follow them across devices.
    match /playCompletions/{uid}/days/{dateId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.dateId is string
        && request.resource.data.dateId.size() == 10
        && request.resource.data.games is map
        && request.resource.data.games.size() <= 12;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Admin-editable niyam list. Public read.
    match /niyams/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Personal niyam ticks. Doc ID = Auth UID.
    match /niyamProgress/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Aggregate encouragement stats (counts + participants). Public read; signed-in write.
    match /niyamStats/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Privacy / policy pages. Public read; admin write.
    match /sitePages/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin-managed homepage tiles, navigation, and community prompts. Public read.
    match /siteContent/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
