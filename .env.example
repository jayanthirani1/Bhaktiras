# Firebase web app config.
# Copy to .env and fill in from Firebase Console -> Project settings -> General -> Your apps.
# No quotes around values. Restart the dev server after editing.
#
# These are NUXT_PUBLIC_* and are baked into the client bundle at build time —
# they are not secrets. Firestore security rules are what protect your data.

NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Web Push certificate key pair, from Project settings -> Cloud Messaging.
# Without it the browser cannot request a push token, so notifications fail
# silently. nuxt.config.ts reads it and CI injects it, but it was missing here.
NUXT_PUBLIC_FIREBASE_VAPID_KEY=

# Flickr, for the darshan galleries. Unlike the Firebase values above this is a
# real rate-limited credential, and it is baked into the client bundle.
NUXT_PUBLIC_FLICKR_API_KEY=
NUXT_PUBLIC_FLICKR_USER_ID=
